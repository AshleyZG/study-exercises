{
  "version": "2.0.0",
  "tasks": [
    {
      // Default build task, so Ctrl/Cmd+Shift+B runs whichever file is open.
      "label": "Run this file",
      "type": "shell",
      "command": "python3 ${file}",
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
